{
  "package": "com.chenxuecong.citybloxx",
  "name": "都市摩天楼",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.app"
    },
    {
      "name": "system.storage"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 192
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      },
      "pages/tower": {
        "component": "tower"
      },
      "pages/gameover": {
        "component": "gameover"
      },
      "pages/highscore": {
        "component": "highscore"
      }
    }
  },
  "window": {
    "status-bar": false
  }
}