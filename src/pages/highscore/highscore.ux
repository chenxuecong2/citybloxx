<template>
  <div class="page" ontouchmove="preventScroll">
    <div class="center-area">
      <text class="score-text">{{ bestScore }}</text>
      <text class="score-unit">层</text>
    </div>
    <input class="back-btn" type="button" value="&lt; 返回" onclick="goBack" />
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"

export default {
  private: {
    bestScore: 0
  },

  onInit() {
    const self = this
    storage.get({
      key: 'highscore',
      success: function(data) {
        self.bestScore = parseInt(data, 10) || 0
      },
      fail: function() {
        self.bestScore = 0
      }
    })
  },

  goBack() {
    router.back()
  },

  preventScroll() {}
}
</script>

<style>
.page {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  background-color: #87CEEB;
}

.center-area {
  flex-direction: column;
  align-items: center;
  margin-bottom: 60px;
}

.score-text {
  font-size: 48px;
  color: #ffffff;
  font-weight: bold;
}

.score-unit {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.7);
  margin-top: -4px;
}

.back-btn {
  position: fixed;
  bottom: 16px;
  width: 140px;
  height: 42px;
  border-radius: 21px;
  background-color: #ffffff;
  font-size: 15px;
  color: #333333;
  border: none;
}
</style>
