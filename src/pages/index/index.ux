<template>
  <div class="page" ontouchmove="preventScroll">
    <text class="title">都市摩天楼</text>
    <div class="menu">
      <div class="menu-item" onclick="routeTower">
        <text class="menu-text">快速游戏</text>
      </div>
      <div class="menu-item" onclick="showHighscore">
        <text class="menu-text">最高分</text>
      </div>
      <div class="menu-item" onclick="exitApp">
        <text class="menu-text">退出</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import app from "@system.app"

export default {
  routeTower() {
    router.push({ uri: "/pages/tower" })
  },
  showHighscore() {
    router.push({ uri: "/pages/highscore" })
  },
  exitApp() {
    app.terminate()
  },

  preventScroll() {}
}
</script>

